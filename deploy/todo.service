# Flask の Todo アプリを gunicorn で常駐させる systemd unit です。
# /etc/systemd/system/todo.service へ配置します（deploy/setup.sh が行います）。

[Unit]
Description=Flask Todo アプリ（gunicorn）
Documentation=https://docs.gunicorn.org/en/stable/settings.html
# Azure SQL Database へ接続するため、ネットワークが使える状態になるまで待ちます
Wants=network-online.target
After=network-online.target

# app.py の構文エラーのように、再起動しても直らない失敗を failed 状態として
# 検出できるようにします。既定の制限（10 秒間に 5 回）では RestartSec=5 の間隔に
# 引っかからず、永久に再起動を繰り返して systemctl is-active が通ってしまいます。
# この 2 つは [Service] ではなく [Unit] の設定です（systemd 229 で移動しました）
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# ExecStart の起動が完了するまで systemd が待つため、パスの誤りをすぐに検出できます
Type=exec

# root では起動しません。アプリ専用の低権限ユーザーを使います
User=todo
Group=todo

# uv プロジェクトのルートです。uv run はここの pyproject.toml と uv.lock、
# それに uv sync が作った .venv を使います
WorkingDirectory=/opt/todo

# 接続情報は /opt/todo/src/.env（パーミッション 600）に一本化します。
# Environment= や EnvironmentFile= では渡しません。app.py が load_dotenv() で
# 読むため、併用するとどちらが効いているのか追えなくなります。
#
# FLASK_DEBUG はどこにも書きません。値が 1 になると Werkzeug のデバッガが
# 有効になり、ブラウザの画面から任意のコードを実行できる状態になります。
#
# uv 側の指定です。
#   --frozen            uv.lock のバージョンをそのまま使います
#   --no-dev            ruff と pytest を対象から外します。setup.sh の uv sync も
#                       --no-dev で入れているため、指定しないと初回起動時に
#                       uv が入れ直します。uv run は不足分を足すだけで余分は
#                       削除しないため、減らす側は uv sync の担当です
#
# gunicorn の設定は引数で渡します（gunicorn.conf.py は作りません）。
#   --chdir src         gunicorn が src を sys.path に入れてから app:app を
#                       import します。src/.env は app.py がパスを明示して読むため、
#                       起動場所には依存しません
#   --bind              ループバックだけで待ち受けます。0.0.0.0 にすると、認証の
#                       ないアプリが nginx を経由せずネットワークへ公開されます
#   --workers 3         gunicorn 公式の目安（2 × CPU + 1）どおりです。VM は 1 vCPU
#                       ですが、DB 待ちでワーカーが数十秒塞がるため、1 つでは
#                       1 人の操作でアプリ全体が無応答になります
#   --timeout 150       既定は 30 秒です。停止した Azure SQL の再開を待つリトライは
#                       1 接続あたり最悪 70 秒、一覧の表示では接続を 2 回張るため
#                       140 秒かかります。既定のままではその最中にワーカーが
#                       SIGKILL され、画面には 500 が返ります。
#                       「アプリ 140 秒 < gunicorn 150 秒 < nginx 180 秒」の順に
#                       長くします（nginx 側は proxy_read_timeout です）
#   --access-logfile -  標準出力へ出し、journalctl -u todo から読めるようにします。
#                       既定では 1 行も出ません。--access-logformat は指定しません。
#                       systemd は % をスペシファイアとして解釈するため、書式指定子を
#                       そのまま書くと unit の読み込みに失敗します
ExecStart=/usr/local/bin/uv run --frozen --no-dev gunicorn --chdir src \
    --bind 127.0.0.1:8000 --workers 3 --timeout 150 --access-logfile - app:app

# 異常終了しても自動で復旧させます。再起動の頻度の上限は [Unit] で設定しています
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
